<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.7</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Author>keifufu</Author>
    <Name>JobTitles</Name>
    <Punchline>No longer will you be an Archmage Monk, set a different title per job!</Punchline>
    <Description>Changes your title based on the current job, with per-character settings.</Description>
    <RepoUrl>https://github.com/keifufu/JobTitles</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/keifufu/JobTitles/main/images/icon.png</IconUrl>
    <Tags>job;class;title</Tags>
  </PropertyGroup>

  <ItemGroup>
    <Content Include=".\images\gambler.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>gambler.png</TargetPath>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
  </ItemGroup>
</Project>
